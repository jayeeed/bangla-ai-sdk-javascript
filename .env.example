# ==============================================================
# Bangla AI JavaScript SDK - Environment Configuration Template
# ==============================================================
# Copy this file to .env and configure your values:
#   cp .env.example .env

# Required: Developer API Key for the Bangla AI Gateway
# Generate this from the web dashboard or via client.apiKeys.create()
BANGLA_AI_API_KEY="sk_live_your_bangla_ai_api_key_here"

# Optional: Gateway Endpoint Base URL
# Default: https://banglai.acimisai.com
# For local gateway instances: http://localhost:8000
BANGLA_AI_BASE_URL="https://banglai.acimisai.com"

# Optional: Client HTTP request timeout in milliseconds (Default: 60000)
BANGLA_AI_TIMEOUT="60000"

# Optional: Automatic retry attempts for 429 and 503 errors (Default: 2)
BANGLA_AI_MAX_RETRIES="2"
