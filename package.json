    "asr",
    "tts",
    "sts",
    "speech",
    "livekit",
    "gateway"
  ],
  "author": "Jayed <jayedbinjahangir@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jayeeed/bangla-ai-sdk-javascript"
  },
  "homepage": "https://github.com/jayeeed/bangla-ai-sdk-javascript",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    }
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "dotenv": "^16.4.5"
